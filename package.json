{
  "name": "moneyanalyze-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"host-w,host-p,auth-w,auth-p,main-w,main-p,admin-w,admin-p\" -c \"bgBlue,blue,bgGreen,green,bgMagenta,magenta,bgCyan,cyan\" \"npm run build:watch -w apps/host\" \"npm run preview -w apps/host\" \"npm run build:watch -w apps/auth\" \"npm run preview -w apps/auth\" \"npm run build:watch -w apps/main\" \"npm run preview -w apps/main\" \"npm run build:watch -w apps/admin\" \"npm run preview -w apps/admin\"",
    "build": "npm run build -w apps/auth && npm run build -w apps/main && npm run build -w apps/admin && npm run build -w apps/host",
    "postbuild": "rm -rf /var/www/moneyanalyze/* && cp -r apps/host/dist/* /var/www/moneyanalyze/ || true",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "lucide-react": "^1.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "styled-components": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@originjs/vite-plugin-federation": "^1.3.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
